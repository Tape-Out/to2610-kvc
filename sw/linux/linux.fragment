CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
# 前两项 buildroot 随后自己也设；先写上，合并配置时「不压缩」那一项才看得见，否则被丢掉又回到 gzip
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="${BR_BINARIES_DIR}/rootfs.cpio"
CONFIG_INITRAMFS_COMPRESSION_NONE=y
# busybox 的 ip link set address 与 udhcpc 都要开 AF_PACKET 套接字，上游的配置里没有
CONFIG_PACKET=y
CONFIG_SPI_SPIDEV=y
CONFIG_TO2610_GPU=y
CONFIG_VFAT_FS=y
CONFIG_NLS_ISO8859_1=y
